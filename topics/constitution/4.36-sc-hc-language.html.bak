    <!-- ===== SECTION 8: AI വിവർത്തന സംവിധാനങ്ങൾ ===== -->
    <section class="section" id="sec8">
      <h2 role="button" tabindex="0" aria-expanded="false">8. AI വിവർത്തന സംവിധാനങ്ങൾ</h2>
      <div class="section-body">
        <div class="added-fact">
          <span class="box-label">➕ SUVAS (Supreme Court Vidhik Anuvaad Software)</span>
          <ul>
            <li>സുപ്രീം കോടതി വികസിപ്പിച്ച <strong>AI സഹായത്തോടെയുള്ള വിവർത്തന സോഫ്റ്റ്‌വെയർ</strong>.</li>
            <li>സുപ്രീം കോടതി വിധികൾ പ്രാദേശിക ഭാഷകളിലേക്ക് വിവർത്തനം ചെയ്യാൻ ഉപയോഗിക്കുന്നു.</li>
            <li><strong>ആധികാരിക പാഠം ഇംഗ്ലീഷ് തന്നെ</strong>; പരിഭാഷകൾ മാത്രം.</li>
          </ul>
        </div>

        <div class="added-fact">
          <span class="box-label">➕ Anuvadini AI ടൂൾ</span>
          <ul>
            <li>AICTE വികസിപ്പിച്ച AI വിവർത്തന ടൂൾ.</li>
            <li>2023 മധ്യത്തോടെ കേരള ഹൈക്കോടതിയുടെ <strong>317 വിധികളും</strong> ജില്ലാ കോടതികളുടെ <strong>5,000-ലധികം വിധികളും</strong> ഈ ടൂൾ ഉപയോഗിച്ച് മലയാളത്തിലേക്ക് വിവർത്തനം ചെയ്ത് വെബ്സൈറ്റിൽ ലഭ്യമാക്കി.</li>
            <li>ഹൈക്കോടതി ജഡ്ജിമാരുടെ സമിതി പരിശോധിച്ചാണ് പ്രസിദ്ധീകരണം.</li>
          </ul>
        </div>

        <div class="added-fact">
          <span class="box-label">➕ സുപ്രീം കോടതി Vernacular Judgments</span>
          <ul>
            <li>2019 ജൂലൈ മുതൽ പ്രാദേശിക ഭാഷകളിലെ വിധികൾ <strong>"Vernacular Judgments"</strong> എന്ന ടാബിൽ ലഭ്യമാക്കാൻ തുടങ്ങി.</li>
            <li><strong>e-SCR</strong> വിവർത്തനങ്ങൾ.</li>
          </ul>
        </div>

        <div class="added-fact">
          <span class="box-label">➕ കേരള ഹൈക്കോടതി നാഴികക്കല്ല്</span>
          <ul>
            <li><strong>2023 ഫെബ്രുവരി 21</strong> (അന്താരാഷ്ട്ര മാതൃഭാഷാ ദിനം): ചീഫ് ജസ്റ്റിസ് എസ്. മണികുമാർ, ജസ്റ്റിസ് ഷാജി പി. ചാലി എന്നിവരുടെ ഡിവിഷൻ ബെഞ്ചിന്റെ <strong>രണ്ട് വിധികളുടെ മലയാളം പരിഭാഷ</strong> പ്രസിദ്ധീകരിച്ചു.</li>
            <li><strong>ഒരു ഹൈക്കോടതി ഇത്തരത്തിൽ പ്രാദേശിക ഭാഷയിൽ വിധി പ്രസിദ്ധീകരിക്കുന്നത് രാജ്യത്ത് ആദ്യം.</strong></li>
          </ul>
        </div>

        <div class="added-fact">
          <span class="box-label">➕ ജില്ലാ/കീഴ്ക്കോടതികളുടെ ഭാഷ</span>
          <ul>
            <li>ഇവയിലെ ഭാഷ നിശ്ചയിക്കുന്നത് ആർട്ടിക്കിൾ 348 അല്ല.</li>
            <li><strong>സംസ്ഥാന സർക്കാർ ഹൈക്കോടതിയുമായി ആലോചിച്ച്</strong> (ആർട്ടിക്കിൾ 235 പ്രകാരം ഭരണ നിയന്ത്രണം ഹൈക്കോടതിക്ക്).</li>
            <li>കീഴ്ക്കോടതികളിൽ പൊതുവെ പ്രാദേശിക ഭാഷ/ഹിന്ദി ഉപയോഗിക്കുന്നു.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== SECTION 9: PSC വിശകലനം ===== -->
    <section class="section" id="sec9">
      <h2 role="button" tabindex="0" aria-expanded="false">9. കേരള PSC പരീക്ഷാ വിശകലനം</h2>
      <div class="section-body">
        <ul>
          <li><span class="stars">⭐⭐⭐⭐⭐</span> <strong>വളരെ സാധ്യത:</strong> ആർട്ടിക്കിൾ 348 (കോടതി ഭാഷ ഇംഗ്ലീഷ്), ഗവർണർ + രാഷ്ട്രപതി അനുമതി, ഹിന്ദി HC 4 എണ്ണം (RUMB).</li>
          <li><span class="stars">⭐⭐⭐⭐</span> <strong>ആവർത്തിച്ച് ചോദിക്കാവുന്നത്:</strong> ആർട്ടിക്കിൾ 349 (15 വർഷം), സുപ്രീം കോടതിയുടെ ഭാഷ, കേരള ഹൈക്കോടതി മലയാളം വിധി.</li>
          <li><span class="stars">⭐⭐⭐</span> <strong>ശ്രദ്ധിക്കേണ്ടത്:</strong> SUVAS, ഔദ്യോഗിക ഭാഷാ നിയമം 1963, CJI ഉപദേശം (1965 കീഴ്വഴക്കം).</li>
          <li><span class="stars">⭐⭐⭐</span> <strong>ചോദ്യ സാധ്യത:</strong> ആർട്ടിക്കിൾ 348(3) ഗസറ്റ് പരിഭാഷ, ഛത്തീസ്ഗഢിന്റെ ഹിന്ദി അഭ്യർത്ഥന നിരസിക്കൽ, മദ്രാസ് HC തമിഴ് നിർദ്ദേശം നിരസിക്കൽ.</li>
        </ul>
      </div>
    </section>

    <!-- ===== SECTION 10: ആശയക്കുഴപ്പങ്ങൾ ===== -->
    <section class="section" id="sec10">
      <h2 role="button" tabindex="0" aria-expanded="false">10. ആശയക്കുഴപ്പമുള്ള വസ്തുതകൾ</h2>
      <div class="section-body">
        <div style="overflow-x: auto;">
          <table>
            <thead>
              <tr><th>Fact 1</th><th>Fact 2</th><th>ശരിയായ വ്യത്യാസം</th></tr>
            </thead>
            <tbody>
              <tr><td><strong>ആർട്ടിക്കിൾ 343</strong></td><td><strong>ആർട്ടിക്കിൾ 348</strong></td><td>343 = കേന്ദ്രത്തിന്റെ ഔദ്യോഗിക ഭാഷ (ഹിന്ദി, ദേവനാഗരി). 348 = കോടതികളുടെ ഭാഷ (ഇംഗ്ലീഷ്).</td></tr>
              <tr><td><strong>ആർട്ടിക്കിൾ 348</strong></td><td><strong>ആർട്ടിക്കിൾ 349</strong></td><td>348 = ഭാഷ നിശ്ചയിക്കുന്ന വ്യവസ്ഥ. 349 = ഭാഷാ ബില്ലിനുള്ള നടപടിക്രമ നിയന്ത്രണം (15 വർഷം).</td></tr>
              <tr><td><strong>ഗവർണർ (348(2))</strong></td><td><strong>ചീഫ് ജസ്റ്റിസ് (CJI)</strong></td><td>ഗവർണർ ഉത്തരവിടുന്നു (രാഷ്ട്രപതിയുടെ അനുമതിയോടെ). CJI **ഉപദേശകൻ മാത്രം** (1965 കീഴ്വഴക്കം പ്രകാരം).</td></tr>
              <tr><td><strong>നടപടിക്രമങ്ങൾ (Proceedings)</strong></td><td><strong>വിധികൾ (Judgments)</strong></td><td>348(2): നടപടിക്രമങ്ങൾക്ക് ഹിന്ദി/സംസ്ഥാന ഭാഷ അനുവദിക്കാം. വിധികൾക്ക് 1963-ലെ നിയമം (Sec. 7) വഴി — ഇംഗ്ലീഷിനൊപ്പം.</td></tr>
              <tr><td><strong>ആധികാരിക പാഠം</strong></td><td><strong>പരിഭാഷ</strong></td><td>ആധികാരിക പാഠം ഇംഗ്ലീഷ്. പ്രാദേശിക ഭാഷയിലേത് **പരിഭാഷ മാത്രം** (ആധികാരികമല്ല).</td></tr>
              <tr><td><strong>ഹിന്ദി HC 4 എണ്ണം</strong></td><td><strong>ആകെ HC 25 എണ്ണം</strong></td><td>ആകെ 25 ഹൈക്കോടതികളിൽ 4 എണ്ണത്തിന് മാത്രം ഹിന്ദി അനുമതി.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===== SECTION 11: താരതമ്യ പട്ടികകൾ ===== -->
    <section class="section" id="sec11">
      <h2 role="button" tabindex="0" aria-expanded="false">11. താരതമ്യ പട്ടികകൾ</h2>
      <div class="section-body">
        <h3>Table 1: Part XVII അധ്യായങ്ങൾ</h3>
        <div style="overflow-x: auto;">
          <table>
            <thead>
              <tr><th>അധ്യായം</th><th>ആർട്ടിക്കിളുകൾ</th><th>വിഷയം</th></tr>
            </thead>
            <tbody>
              <tr><td>I</td><td>343–344</td><td>യൂണിയന്റെ ഭാഷ</td></tr>
              <tr><td>II</td><td>345–347</td><td>പ്രാദേശിക ഭാഷകൾ</td></tr>
              <tr><td><strong>III</strong></td><td><strong>348–349</strong></td><td><strong>കോടതികളുടെയും നിയമങ്ങളുടെയും ഭാഷ</strong></td></tr>
              <tr><td>IV</td><td>350–351</td><td>പ്രത്യേക നിർദ്ദേശങ്ങൾ</td></tr>
