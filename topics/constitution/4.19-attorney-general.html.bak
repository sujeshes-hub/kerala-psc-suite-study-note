            <text x="282" y="115" text-anchor="middle" fill="#fff" font-size="12" font-weight="bold">177 (Assembly)</text>

            <rect x="20" y="150" width="120" height="40" rx="8" fill="#4a148c" opacity="0.9"/>
            <text x="80" y="175" text-anchor="middle" fill="#fff" font-size="12" font-weight="bold">105 (Privilege)</text>
            <line x1="140" y1="170" x2="200" y2="170" stroke="#4a148c" stroke-width="3"/>
