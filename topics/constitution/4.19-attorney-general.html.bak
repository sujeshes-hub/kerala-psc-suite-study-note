            <line x1="140" y1="50" x2="200" y2="50" stroke="#4a148c" stroke-width="3"/>
            <text x="170" y="42" text-anchor="middle" font-size="11" fill="#b83b2c" font-weight="bold">+89</text>
            <polygon points="200,44 212,50 200,56" fill="#4a148c"/>
